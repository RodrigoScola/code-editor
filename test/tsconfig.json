{
  // Type checking for the specs. The root tsconfig only builds src/, so
  // without this the editor gives test files a default project that misses
  // src/globals.d.ts (KeyEvent, EditingModes, ...).
  //
  //   npx tsc -p test
  //
  // Specs for features that aren't built yet still show errors: a missing
  // module or method is how those specs fail.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    // the specs run through vitest, which resolves imports like a bundler:
    // "../src/ui/colors" and "../src/ui/colors.js" both work. src/ keeps
    // NodeNext (the root tsconfig) because dist/ runs in plain node, where
    // the .js is required
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": ["../src", "."]
}
